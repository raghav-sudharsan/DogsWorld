<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore"
             path="*"
             verb="*"
             modules="AspNetCoreModuleV2"
             resourceType="Unspecified" />
        <remove name="WebDAV" />
      </handlers>

      <aspNetCore
        processPath="C:\Users\ragha\Source\DogsWorld\bin\Debug\netcoreapp3.1\DogsWorld.exe"
        arguments=""
        stdoutLogEnabled="false"
        hostingModel="InProcess">
        <environmentVariables>
          <environmentVariable
            name="ASPNETCORE_ENVIRONMENT"
            value="Development" />
        </environmentVariables>
      </aspNetCore>

    </system.webServer>
  </location>
</configuration>
